{
	"name": "ensemblr",
	"packageManager": "pnpm@12.16.1",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "26"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"test": "node --experimental-strip-types --test src/lib/markdown/parser.test.ts src/lib/oidc-policy.test.ts src/lib/server/session-policy.test.ts src/lib/workspace.test.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "vite-node scripts/seed.ts",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@iconify/tailwind4": "^1.2.3",
		"@inlang/paraglide-js": "^3.1.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.68.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.6.6",
		"auth": "^1.7.16",
		"better-auth": "^1.7.16",
		"bits-ui": "^2.20.4",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"postgres": "^4.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.8.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.1",
		"tailwindcss": "^4.3.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vite-node": "^6.0.0"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.96",
		"@ai-sdk/cerebras": "^3.0.84",
		"@ai-sdk/cohere": "^4.0.75",
		"@ai-sdk/deepinfra": "^3.0.84",
		"@ai-sdk/google": "^4.0.111",
		"@ai-sdk/groq": "^4.0.76",
		"@ai-sdk/mistral": "^4.0.79",
		"@ai-sdk/openai": "^4.0.108",
		"@ai-sdk/openai-compatible": "^3.0.84",
		"@ai-sdk/perplexity": "^5.0.26",
		"@ai-sdk/togetherai": "^3.0.85",
		"@ai-sdk/xai": "^5.0.38",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@openrouter/ai-sdk-provider": "^3.1.0",
		"ai": "^7.0.162",
		"mode-watcher": "^1.1.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"unified": "^11.0.5",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
