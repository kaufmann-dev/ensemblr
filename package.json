{
	"name": "ensemblr",
	"packageManager": "pnpm@11.18.0",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.17.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"test": "node --experimental-strip-types --test src/lib/markdown/parser.test.ts src/lib/oidc-policy.test.ts src/lib/server/session-policy.test.ts src/lib/workspace.test.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "vite-node scripts/seed.ts",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@iconify/tailwind4": "^1.2.3",
		"@inlang/paraglide-js": "^2.25.4",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.49.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/mdast": "^4.0.4",
		"@types/node": "^22.20.4",
		"auth": "^1.7.6",
		"better-auth": "^1.7.6",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.3",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"postgres": "^3.4.9",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.1",
		"vite-node": "^6.0.0"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.70",
		"@ai-sdk/cerebras": "^3.0.61",
		"@ai-sdk/cohere": "^4.0.54",
		"@ai-sdk/deepinfra": "^3.0.61",
		"@ai-sdk/google": "^4.0.87",
		"@ai-sdk/groq": "^4.0.54",
		"@ai-sdk/mistral": "^4.0.56",
		"@ai-sdk/openai": "^4.0.83",
		"@ai-sdk/openai-compatible": "^3.0.61",
		"@ai-sdk/perplexity": "^5.0.5",
		"@ai-sdk/togetherai": "^3.0.62",
		"@ai-sdk/xai": "^5.0.14",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/recursive": "^5.3.0",
		"@openrouter/ai-sdk-provider": "^3.1.0",
		"ai": "^7.0.124",
		"mode-watcher": "^1.1.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"unified": "^11.0.5",
		"zod": "^4.6.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
