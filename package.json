{
	"name": "ensemblr",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"test": "node --experimental-strip-types --test src/lib/markdown/parser.test.ts src/lib/oidc-policy.test.ts src/lib/server/session-policy.test.ts src/lib/workspace.test.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "vite-node scripts/seed.ts",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@iconify/tailwind4": "^1.2.3",
		"@inlang/paraglide-js": "^2.25.4",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.49.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/mdast": "^4.0.4",
		"@types/node": "^22.20.4",
		"auth": "^1.6.33",
		"better-auth": "~1.6.33",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.3",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"postgres": "^3.4.9",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.1",
		"vite-node": "^6.0.0"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^3.0.126",
		"@ai-sdk/cerebras": "^2.0.87",
		"@ai-sdk/cohere": "^3.0.67",
		"@ai-sdk/deepinfra": "^2.0.85",
		"@ai-sdk/google": "^3.0.130",
		"@ai-sdk/groq": "^3.0.72",
		"@ai-sdk/mistral": "^3.0.70",
		"@ai-sdk/openai": "^3.0.122",
		"@ai-sdk/openai-compatible": "^2.0.81",
		"@ai-sdk/perplexity": "^3.1.2",
		"@ai-sdk/togetherai": "^2.0.87",
		"@ai-sdk/xai": "^3.0.139",
		"@fontsource-variable/recursive": "^5.3.0",
		"@openrouter/ai-sdk-provider": "^2.10.0",
		"ai": "^6.0.298",
		"mode-watcher": "^1.1.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"unified": "^11.0.5",
		"zod": "^4.6.5"
	}
}
